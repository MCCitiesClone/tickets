# =========================================================================
# Tickets — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored.
# =========================================================================

# --- Database -------------------------------------------------------------
# Used for LOCAL (non-Docker) development. With Docker Compose, DATABASE_URL is
# set automatically from the POSTGRES_* values below, so you can leave this as
# the localhost default.
DATABASE_URL=postgres://tickets:tickets@localhost:5432/tickets

# Postgres credentials for the Docker Compose `postgres` service.
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets

# --- Discord application ---------------------------------------------------
# Create an app at https://discord.com/developers/applications
# See docs/discord-setup.md for a step-by-step guide.
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-oauth2-client-secret

# Optional: register slash commands to a single guild for instant updates
# during development. Leave empty to register globally.
DISCORD_DEV_GUILD_ID=

# --- Auth (web dashboard) --------------------------------------------------
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the dashboard. Must match the OAuth redirect base in Discord.
BETTER_AUTH_URL=http://localhost:3000

# --- Attachment archiving --------------------------------------------------
# Ticket attachments are copied off Discord's expiring CDN into local storage so
# transcripts stay intact after channels are deleted. The bot writes here and
# the web app serves from it, so both need the SAME path (a shared volume under
# Docker). All optional — the defaults below work out of the box.
#
# ATTACHMENT_ARCHIVE_DIR=.data/attachments   # Docker default: /data/attachments
# ATTACHMENT_ARCHIVE_ENABLED=true            # set false to keep Discord URLs
# ATTACHMENT_MAX_BYTES=26214400              # skip files larger than this (25 MiB)
